# Environment Variables Template
# Copy this file to .env.local for local development

# Neon Postgres
# Pooled connection string, used for app queries
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
# Direct (unpooled) connection string, used by Auth.js and migrations
DATABASE_URL_UNPOOLED=postgresql://user:password@host/dbname?sslmode=require

# Vercel Blob (map image storage)
BLOB_READ_WRITE_TOKEN=your-blob-read-write-token

# Auth.js
# Generate with: npx auth secret
AUTH_SECRET=your-auth-secret
# Google OAuth client
AUTH_GOOGLE_ID=your-google-oauth-client-id
AUTH_GOOGLE_SECRET=your-google-oauth-client-secret

# Google Cloud / Vertex AI
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# Local Development Only
# Path to your service account JSON file
GOOGLE_APPLICATION_CREDENTIALS=path/to/your/service-account.json

# Production Only (Vercel)
# Base64 encoded service account JSON
# Generate with: base64 -i path/to/service-account.json
GOOGLE_SERVICE_ACCOUNT_KEY=env_base64_encoded_key
