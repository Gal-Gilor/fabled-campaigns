{
  "name": "fabled-campaigns",
  "version": "1.0.0",
  "description": "AI-powered fantasy battle map generator",
  "main": "index.js",
  "scripts": {
    "build": "echo 'No build step required for static files'",
    "start": "python3 -m http.server 3000",
    "serve": "python3 -m http.server 3000",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint lib/ api/ js/",
    "lint:fix": "eslint lib/ api/ js/ --fix",
    "format": "prettier --write lib/ api/ js/",
    "format:check": "prettier --check lib/ api/ js/"
  },
  "dependencies": {
    "@google/genai": "^0.3.0"
  },
  "devDependencies": {
    "dotenv": "^16.0.0",
    "jest": "^29.7.0",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "supertest": "^6.3.4"
  },
  "keywords": ["ai", "maps", "fantasy", "rpg", "d&d"],
  "author": "Fabled Campaigns",
  "license": "MIT"
}