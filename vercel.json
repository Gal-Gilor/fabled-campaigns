{
  "buildCommand": "echo 'No build required'",
  "outputDirectory": ".",
  "functions": {
    "api/maps/generateMap.js": {
      "maxDuration": 30,
      "memory": 512
    },
    "api/maps/generateName.js": {
      "maxDuration": 15,
      "memory": 512
    }
  },
  "rewrites": [
    {
      "source": "/maps",
      "destination": "/pages/maps.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "https://fabled-campaigns.vercel.app"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET, POST, OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type, Authorization"
        }
      ]
    }
  ]
}